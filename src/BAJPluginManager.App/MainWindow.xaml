<Window x:Class="BAJPluginManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BAJPluginManager.App"
        Title="CRM Manager - Development only" Width="1400" Height="900"
        Icon="Assets/CrmManager.ico" MinWidth="1100" MinHeight="720"
        Style="{StaticResource {x:Type Window}}" WindowStartupLocation="CenterScreen" Closing="Window_Closing">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="224"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="40"/></Grid.RowDefinitions>
        <Border Grid.RowSpan="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="24,28,12,30">
                    <Image Source="Assets/CrmManager.ico" Width="40" Height="40" HorizontalAlignment="Left" Margin="0,0,0,14"/>
                    <TextBlock Text="CRM Manager" FontSize="21" FontWeight="SemiBold"/>
                    <TextBlock Text="Your development workspace" Style="{StaticResource Caption}" FontSize="11" Margin="0,5,0,0"/>
                </StackPanel>
                <Border DockPanel.Dock="Bottom" Margin="16,20" Padding="12" Background="#F5F7FB" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="DEVELOPMENT ONLY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="Dynamics 365 on-premises 9.1" Style="{StaticResource Caption}" FontSize="11" Margin="0,5,0,0"/>
                        <TextBlock Text="Higher environments stay manual." Style="{StaticResource Caption}" FontSize="11"/>
                    </StackPanel>
                </Border>
                <StackPanel x:Name="Navigation">
                    <TextBlock Text="WORKSPACE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="26,0,0,10"/>
                    <RadioButton x:Name="ConnectionNav" GroupName="Pages" Tag="0" IsChecked="True" Style="{StaticResource NavigationItem}" AutomationProperties.Name="Connection">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" Margin="0,2,12,0"/><TextBlock Text="Connection" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="PluginsNav" GroupName="Pages" Tag="1" Style="{StaticResource NavigationItem}" AutomationProperties.Name="Plugins">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xEA86;" FontFamily="Segoe MDL2 Assets" Margin="0,2,12,0"/><TextBlock Text="Plugins" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="ResourcesNav" GroupName="Pages" Tag="2" Style="{StaticResource NavigationItem}" AutomationProperties.Name="Web resources">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE943;" FontFamily="Segoe MDL2 Assets" Margin="0,2,12,0"/><TextBlock Text="Web resources" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="SolutionsNav" GroupName="Pages" Tag="3" Style="{StaticResource NavigationItem}" AutomationProperties.Name="Solution exports">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" Margin="0,2,12,0"/><TextBlock Text="Solution exports" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="28,22">
                <DockPanel>
                    <Border x:Name="ConnectionBadge" DockPanel.Dock="Right" VerticalAlignment="Center" CornerRadius="16" Background="#F0F3F8" Padding="12,7" Margin="18,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ConnectionDot" Width="7" Height="7" Fill="#78869B" Margin="0,0,7,0"/>
                            <TextBlock x:Name="ConnectionBadgeText" Text="Not connected" FontSize="12" FontWeight="SemiBold" MaxWidth="240" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                    <StackPanel>
                        <TextBlock x:Name="PageTitle" Text="Connect to your CRM" FontSize="26" FontWeight="SemiBold"/>
                        <TextBlock x:Name="PageDescription" Text="A secure connection to your on-premises development organization." Style="{StaticResource Caption}" Margin="0,5,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border x:Name="ConnectionRequired" Grid.Row="1" Visibility="Collapsed" Background="{StaticResource AccentSoftBrush}" CornerRadius="8" Padding="16,10" Margin="28,18,28,0">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Go to connection" Style="{StaticResource QuietButton}" Click="GoToConnection_Click"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Connect to unlock this workspace" FontWeight="SemiBold"/>
                        <TextBlock Text="Connect using your organization URL and credentials. No data has been loaded." Style="{StaticResource Caption}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Grid x:Name="Workspace" Grid.Row="2" Margin="28,22,28,0">
                    <ScrollViewer x:Name="ConnectionPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,4">
                        <WrapPanel>
                        <Border Style="{StaticResource Card}" Width="250" VerticalAlignment="Top" Margin="0,0,20,20">
                            <StackPanel x:Name="SavedConnectionControls">
                                <TextBlock Text="Saved connections" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Select a saved development environment. Connecting is always manual." Style="{StaticResource Caption}" Margin="0,0,0,14"/>
                                <ComboBox x:Name="SavedConnectionSelector" DisplayMemberPath="Name" SelectionChanged="SavedConnection_Changed" AutomationProperties.Name="Saved connections"/>
                                <Button x:Name="NewConnectionButton" Content="New connection" Click="NewConnection_Click" Margin="0,14,0,0"/>
                                <Button x:Name="DeleteConnectionButton" Content="Delete selected..." Click="DeleteConnection_Click" Style="{StaticResource QuietButton}" Margin="0,8,0,0"/>
                                <Button x:Name="ForgetConnectionsButton" Content="Forget all saved connections..." Click="ForgetConnections_Click" Style="{StaticResource QuietButton}" Padding="0,9" FontSize="11"/>
                                <TextBlock Text="Passwords are encrypted for this Windows account. Do not share your Windows sign-in." Style="{StaticResource Caption}" FontSize="12" Margin="0,14,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Width="620" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="28" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Organization connection" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Sign in with your Active Directory credentials." Style="{StaticResource Caption}"/>
                                <StackPanel x:Name="ConnectionFields">
                                    <Label Content="Connection _name (for saving)" Target="{Binding ElementName=SavedConnectionName}"/>
                                    <TextBox x:Name="SavedConnectionName" AutomationProperties.Name="Saved connection name" ToolTip="Give each saved development connection a unique name."/>
                                    <Label Content="Organization _URL" Target="{Binding ElementName=OrganizationUrl}"/>
                                    <TextBox x:Name="OrganizationUrl" AutomationProperties.Name="Organization URL" ToolTip="Example: https://crm-server/DevelopmentOrg"/>
                                    <TextBlock Text="Organization base URL or Organization Service URL. Do not use main.aspx." Style="{StaticResource Caption}" FontSize="12" Margin="0,6,0,0"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Label Content="_Domain" Target="{Binding ElementName=AccountDomain}"/>
                                        <Label Grid.Column="2" Content="_Username" Target="{Binding ElementName=AccountUsername}"/>
                                        <TextBox x:Name="AccountDomain" Grid.Row="1" AutomationProperties.Name="Domain" ToolTip="Leave blank for DOMAIN\username or user@domain."/>
                                        <TextBox x:Name="AccountUsername" Grid.Row="1" Grid.Column="2" AutomationProperties.Name="Username" ToolTip="Username, DOMAIN\username, or user@domain."/>
                                    </Grid>
                                    <Label Content="_Password" Target="{Binding ElementName=AccountPassword}"/>
                                    <PasswordBox x:Name="AccountPassword" AutomationProperties.Name="Password"/>
                                </StackPanel>
                                <TextBlock Text="Saving is optional. Save connection remembers these fields and an encrypted password; unsaved edits are not remembered." Style="{StaticResource Caption}" FontSize="12" Margin="0,12,0,0"/>
                                <WrapPanel Margin="0,22,0,0">
                                    <Button x:Name="ConnectButton" Content="Connect to CRM" Click="Connect_Click" Style="{StaticResource PrimaryButton}" MinWidth="160" Margin="0,0,12,0"/>
                                    <Button x:Name="SaveConnectionButton" Content="Save connection..." Click="SaveConnection_Click"/>
                                </WrapPanel>
                                <TextBlock x:Name="ConnectionStatus" Text="Enter your organization URL, username, and password to connect." Style="{StaticResource Caption}" FontSize="12" Margin="0,16,0,0"/>
                            </StackPanel>
                        </Border>
                        </WrapPanel>
                    </ScrollViewer>
                    <Grid x:Name="PluginWorkspace" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,16">
                            <Button DockPanel.Dock="Right" Content="Refresh assemblies" Click="RefreshAssemblies_Click" Margin="16,0,0,0"/>
                            <TextBox x:Name="AssemblySearch" Style="{StaticResource SearchBox}" Tag="Filter assemblies" MaxWidth="420" HorizontalAlignment="Left" MinWidth="250" ToolTip="Filters loaded assembly names only. Expand branches to see their registrations." AutomationProperties.Name="Filter assemblies"/>
                        </DockPanel>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="5*" MinWidth="240"/><ColumnDefinition Width="18"/><ColumnDefinition Width="3*" MinWidth="245"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}" Padding="0">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                                    <DockPanel Margin="18,14">
                                        <TextBlock Text="Registration explorer" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="AssemblyCount" Text="Not loaded" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                    <TreeView x:Name="Plugins" Grid.Row="1" BorderThickness="0" Padding="10,0,10,12" Background="Transparent"
                                              TreeViewItem.Expanded="PluginNode_Expanded" SelectedItemChanged="PluginSelection_Changed" AutomationProperties.Name="Plugin registration explorer">
                                        <TreeView.Resources>
                                            <HierarchicalDataTemplate DataType="{x:Type local:PluginNode}" ItemsSource="{Binding Children}">
                                                <StackPanel Orientation="Horizontal" Margin="2,6" ToolTip="{Binding Label}">
                                                    <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="4" Padding="5,2" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding Kind}" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="SemiBold"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </HierarchicalDataTemplate>
                                            <Style TargetType="TreeViewItem">
                                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="Padding" Value="3"/>
                                            </Style>
                                        </TreeView.Resources>
                                    </TreeView>
                                    <StackPanel x:Name="PluginEmpty" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="300" Margin="24">
                                        <TextBlock Text="Your registrations, connected." FontSize="19" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="PluginEmptyText" Text="Refresh assemblies to begin. Expand an assembly to explore types, steps, and images." Style="{StaticResource Caption}" TextAlignment="Center" Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" Background="Transparent"/>
                            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel>
                                        <TextBlock Text="Selection details" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Text="Actions become available for the selected registration." Style="{StaticResource Caption}" Margin="0,0,0,16"/>
                                        <WrapPanel>
                                            <Button x:Name="NewStepButton" Content="New step" Click="NewStep_Click" IsEnabled="False" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" ToolTip="Select an IPlugin type, or one of its steps or images."/>
                                            <Button x:Name="EditRegistrationButton" Content="Edit" Click="EditRegistration_Click" IsEnabled="False" Margin="0,0,8,8" ToolTip="Select an editable step or image."/>
                                            <Button x:Name="NewImageButton" Content="New image" Click="NewImage_Click" IsEnabled="False" Margin="0,0,8,8" ToolTip="Select an editable step or its image."/>
                                            <Button x:Name="StepStateButton" Content="Enable / disable" Click="StepState_Click" IsEnabled="False" Margin="0,0,8,8" ToolTip="Enable or disable the selected parent step."/>
                                            <Button x:Name="UnregisterStepButton" Content="Unregister step..." Click="UnregisterStep_Click" IsEnabled="False" Margin="0,0,8,8" ToolTip="Select a step to permanently delete its registration and associated images. The plugin type and assembly are retained."/>
                                            <Button x:Name="UnregisterPluginTypeButton" Content="Unregister plugin type..." Click="UnregisterPluginType_Click" IsEnabled="False" Margin="0,0,8,8" ToolTip="Select an IPlugin type to permanently remove it and its steps and images. The assembly and other types are retained."/>
                                            <Button x:Name="UpdateAssemblyButton" Content="Update DLL" Click="UpdateAssembly_Click" IsEnabled="False" Margin="0,0,8,8" ToolTip="Replace the assembly DLL while retaining steps and images."/>
                                            <Button x:Name="RefreshNodeButton" Content="Refresh branch" Click="RefreshPluginNode_Click" IsEnabled="False" Margin="0,0,8,8" ToolTip="Reload the selected branch from CRM."/>
                                        </WrapPanel>
                                        <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,8,0,16"/>
                                        <TextBox x:Name="PluginDetails" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0"
                                             TextWrapping="Wrap" VerticalScrollBarVisibility="Disabled" VerticalContentAlignment="Top"
                                             Text="Select an assembly, type, step, or image to inspect its details." AutomationProperties.Name="Selected registration details"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="18,14" Margin="0,16,0,0">
                            <Expander Header="Register a new assembly">
                                <StackPanel Margin="0,14,0,4">
                                    <TextBlock Text="Enter fully qualified IPlugin type names, one per line. Steps are registered separately after the assembly is created." Style="{StaticResource Caption}"/>
                                    <TextBox x:Name="PluginTypeNames" Height="76" Margin="0,10,0,12" AcceptsReturn="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Plugin type names"/>
                                    <WrapPanel>
                                        <Button Content="Choose signed DLL and register" Click="RegisterAssembly_Click" Margin="0,0,18,0"/>
                                        <CheckBox x:Name="SandboxIsolation" IsChecked="True" Content="Sandbox isolation" VerticalAlignment="Center"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Expander>
                        </Border>
                    </Grid>
                    <Grid x:Name="ResourceWorkspace" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                        <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
                            <TextBlock Text="Edit or upload first. Publish only when you are ready. These are separate, confirmed actions." Style="{StaticResource Caption}"/>
                        </Border>
                        <DockPanel Grid.Row="1" Margin="0,0,0,16">
                            <WrapPanel DockPanel.Dock="Right" Margin="12,0,0,0">
                                <Button Content="Refresh" Click="RefreshResources_Click" Margin="0,0,8,8"/>
                                <Button x:Name="UploadResourceButton" Content="Upload file" Click="UploadResource_Click" IsEnabled="False" Margin="0,0,8,8" ToolTip="Select an existing web resource."/>
                                <Button x:Name="EditResourceButton" Content="Edit code" Click="EditResource_Click" IsEnabled="False" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" ToolTip="Select HTML, CSS, JS, XML, XSL, SVG, or RESX."/>
                                <Button x:Name="PublishResourceButton" Content="Publish selected" Click="PublishResource_Click" IsEnabled="False" Margin="0,0,0,8" ToolTip="Publishes pending changes for the selected resource only."/>
                            </WrapPanel>
                            <TextBox x:Name="ResourceSearch" Style="{StaticResource SearchBox}" Tag="Filter resources" MinWidth="160" VerticalAlignment="Top" AutomationProperties.Name="Filter web resources" ToolTip="Filter loaded resources by name, display name, or type."/>
                        </DockPanel>
                        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                                <DockPanel Margin="18,14">
                                    <TextBlock Text="Web resources" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="ResourceCount" Text="Not loaded" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <DataGrid x:Name="WebResources" Grid.Row="1" SelectionChanged="WebResourceSelection_Changed" AutomationProperties.Name="Web resources">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" MinWidth="150"/>
                                        <DataGridTextColumn Header="Display name" Binding="{Binding DisplayName}" Width="*" MinWidth="120"/>
                                        <DataGridTextColumn Header="Type" Binding="{Binding Details}" Width="125"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <StackPanel x:Name="ResourceEmpty" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Margin="24">
                                    <TextBlock Text="Your code, closer to CRM." FontSize="21" FontWeight="SemiBold" TextAlignment="Center"/>
                                    <TextBlock x:Name="ResourceEmptyText" Text="Refresh to browse existing customizable resources, then select a file to edit or upload." Style="{StaticResource Caption}" TextAlignment="Center" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                    <Grid x:Name="SolutionWorkspace" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,18" Padding="20,16">
                            <DockPanel>
                                <Button x:Name="ExportSolutionButton" DockPanel.Dock="Right" Content="Export selected" Click="ExportSolution_Click" Style="{StaticResource PrimaryButton}" IsEnabled="False" VerticalAlignment="Center" Margin="20,0,0,0" ToolTip="Select a solution below. Export creates a ZIP file; it does not deploy."/>
                                <StackPanel>
                                    <TextBlock Text="Prepare your deployment package" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="Export the published server state. Publish intended changes first." Style="{StaticResource Caption}"/>
                                    <CheckBox x:Name="ExportManaged" Content="Managed package (unchecked = unmanaged)" Margin="0,12,0,0"/>
                                    <Label Content="New _version (optional)" Target="{Binding ElementName=SolutionVersion}"/>
                                    <TextBox x:Name="SolutionVersion" Width="200" HorizontalAlignment="Left" IsEnabled="False"
                                             AutomationProperties.Name="New solution version" ToolTip="Four numbers, for example 1.0.0.50. Leave blank to keep the current version."/>
                                    <TextBlock Text="Leave blank to keep the current version. A new version is saved in CRM before export." Style="{StaticResource Caption}" FontSize="12" Margin="0,6,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <DockPanel Grid.Row="1" Margin="0,0,0,16">
                            <Button DockPanel.Dock="Right" Content="Refresh solutions" Click="RefreshSolutions_Click" Margin="16,0,0,0"/>
                            <TextBox x:Name="SolutionSearch" Style="{StaticResource SearchBox}" Tag="Filter solutions" MaxWidth="420" MinWidth="240" HorizontalAlignment="Left" AutomationProperties.Name="Filter solutions" ToolTip="Filter loaded solutions by display name, unique name, or version."/>
                        </DockPanel>
                        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                                <DockPanel Margin="18,14">
                                    <TextBlock Text="Custom solutions" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="SolutionCount" Text="Not loaded" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <DataGrid x:Name="Solutions" Grid.Row="1" SelectionChanged="SolutionSelection_Changed" AutomationProperties.Name="Solutions">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Selected" Width="80" CanUserSort="False" CanUserReorder="False">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}, Mode=OneWay}"
                                                              IsHitTestVisible="False" Focusable="False" HorizontalAlignment="Center"
                                                              AutomationProperties.Name="Selected solution"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Solution" Binding="{Binding DisplayName}" Width="*" MinWidth="160"/>
                                        <DataGridTextColumn Header="Unique name" Binding="{Binding Name}" Width="*" MinWidth="160"/>
                                        <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="145"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <StackPanel x:Name="SolutionEmpty" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Margin="24">
                                    <TextBlock Text="Ready for the next environment." FontSize="21" FontWeight="SemiBold" TextAlignment="Center"/>
                                    <TextBlock x:Name="SolutionEmptyText" Text="Refresh solutions, select one, and export a managed or unmanaged ZIP. Deploy it manually when ready." Style="{StaticResource Caption}" TextAlignment="Center" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
            </Grid>
            <Border Grid.Row="3" Margin="28,16,28,12" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                <Expander x:Name="ActivityPanel" Header="Activity log" FontSize="12">
                    <TextBox x:Name="OperationLog" Margin="0,10,0,0" Height="140" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" AutomationProperties.Name="Activity log"/>
                </Expander>
            </Border>
        </Grid>
        <Border Grid.Column="1" Grid.Row="1" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="28,0">
            <DockPanel>
                <ProgressBar x:Name="Progress" DockPanel.Dock="Right" Width="130" Height="4" Visibility="Collapsed" Foreground="{StaticResource AccentBrush}" Margin="16,0,0,0"/>
                <TextBlock x:Name="OperationStatus" Text="Ready. Connect to your development organization to get started." FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
