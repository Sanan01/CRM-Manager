<Window x:Class="CRMManager.App.RegistrationEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Plugin registration" Width="880" Height="860" MinWidth="720" MinHeight="600"
        Icon="Assets/CrmManager.ico" Style="{StaticResource {x:Type Window}}"
        WindowStartupLocation="CenterOwner" Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="28,22">
            <StackPanel>
                <TextBlock Text="PLUGIN REGISTRATION" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                <TextBlock x:Name="EditorTitle" Text="Configure your registration" FontSize="25" FontWeight="SemiBold"/>
                <TextBlock Text="Clear settings. Explicit confirmation. Changes apply to development CRM." Style="{StaticResource Caption}" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,20,28,20">
            <StackPanel x:Name="Fields">
                <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,18">
                    <TextBlock x:Name="EnvironmentText" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}" FontSize="12"/>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Registration identity" Style="{StaticResource SectionTitle}"/>
                        <Label Content="_Name" Target="{Binding ElementName=NameBox}" Padding="0,6,0,6"/>
                        <TextBox x:Name="NameBox" AutomationProperties.Name="Registration name"/>
                    </StackPanel>
                </Border>
                <StackPanel x:Name="StepFields">
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Where it runs" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Message and entity are fixed once a step is registered. Global registrations can affect every supported entity." Style="{StaticResource Caption}"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <Label Content="_Message" Target="{Binding ElementName=MessageSelector}"/>
                                    <ComboBox x:Name="MessageSelector" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="Message_Changed" AutomationProperties.Name="Message"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <Label Content="_Primary entity / filter" Target="{Binding ElementName=EntitySelector}"/>
                                    <ComboBox x:Name="EntitySelector" DisplayMemberPath="Name" SelectedValuePath="Id" AutomationProperties.Name="Primary entity"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="How it executes" Style="{StaticResource SectionTitle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition Width="86"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <Label Content="_Stage" Target="{Binding ElementName=StageSelector}"/>
                                    <ComboBox x:Name="StageSelector" SelectedIndex="1" AutomationProperties.Name="Execution stage">
                                        <ComboBoxItem Content="Pre-validation (10)" Tag="10"/>
                                        <ComboBoxItem Content="Pre-operation (20)" Tag="20"/>
                                        <ComboBoxItem Content="Post-operation (40)" Tag="40"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <Label Content="Execution m_ode" Target="{Binding ElementName=ModeSelector}"/>
                                    <ComboBox x:Name="ModeSelector" SelectedIndex="0" AutomationProperties.Name="Execution mode">
                                        <ComboBoxItem Content="Synchronous" Tag="0"/>
                                        <ComboBoxItem Content="Asynchronous" Tag="1"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <Label Content="Or_der" Target="{Binding ElementName=OrderBox}"/>
                                    <TextBox x:Name="OrderBox" Text="1" AutomationProperties.Name="Execution order"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="ExecutionHint" Text="Asynchronous execution is available at Post-operation only." Style="{StaticResource Caption}" Margin="0,10,0,0"/>
                            <CheckBox x:Name="AsyncDelete" Content="Delete successful asynchronous jobs" Margin="0,12,0,0"/>
                            <Label Content="_Filtering attributes (Update only)" Target="{Binding ElementName=FilteringBox}"/>
                            <TextBox x:Name="FilteringBox" AutomationProperties.Name="Filtering attributes" ToolTip="Comma-separated logical names, such as name,telephone1"/>
                            <TextBlock Text="Use comma-separated logical names. Blank means all updates." Style="{StaticResource Caption}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <Expander Header="Description &amp; configuration (optional)">
                            <StackPanel Margin="0,6,0,0">
                                <Label Content="D_escription" Target="{Binding ElementName=DescriptionBox}"/>
                                <TextBox x:Name="DescriptionBox" AcceptsReturn="True" Height="70" VerticalContentAlignment="Top" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Description"/>
                                <Label Content="Unsecure _configuration" Target="{Binding ElementName=ConfigurationBox}"/>
                                <TextBox x:Name="ConfigurationBox" AcceptsReturn="True" Height="100" FontFamily="Consolas" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Unsecure configuration"/>
                                <TextBlock Text="Do not enter secrets. Existing secure configuration, run-as identity, deployment settings, and enabled state are preserved." Style="{StaticResource Caption}" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Expander>
                    </Border>
                </StackPanel>
                <StackPanel x:Name="ImageFields" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Image settings" Style="{StaticResource SectionTitle}"/>
                            <Label Content="Entity _alias" Target="{Binding ElementName=AliasBox}"/>
                            <TextBox x:Name="AliasBox" AutomationProperties.Name="Entity alias"/>
                            <TextBlock Text="The key used by your plugin in PreEntityImages or PostEntityImages." Style="{StaticResource Caption}" Margin="0,6,0,0"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <Label Content="Image _type" Target="{Binding ElementName=ImageSelector}"/>
                                    <ComboBox x:Name="ImageSelector" SelectedIndex="0" AutomationProperties.Name="Image type">
                                        <ComboBoxItem Content="Pre-image" Tag="0"/>
                                        <ComboBoxItem Content="Post-image" Tag="1"/>
                                        <ComboBoxItem Content="Pre-image and post-image" Tag="2"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <Label Content="Message _property" Target="{Binding ElementName=MessagePropertyBox}"/>
                                    <TextBox x:Name="MessagePropertyBox" AutomationProperties.Name="Message property name"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Create, Update, and Delete normally use Target. Other messages require their SDK request property; CRM validates support." Style="{StaticResource Caption}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Keep the payload focused" Style="{StaticResource SectionTitle}"/>
                            <Label Content="Image attri_butes" Target="{Binding ElementName=AttributesBox}"/>
                            <TextBox x:Name="AttributesBox" TextWrapping="Wrap" AcceptsReturn="True" Height="86" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Image attributes"/>
                            <TextBlock Text="Comma-separated logical names. Include only attributes your plugin needs." Style="{StaticResource Caption}" Margin="0,6,0,0"/>
                            <CheckBox x:Name="AllAttributes" Content="Include all attributes (larger payload)" Margin="0,14,0,0"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Create cannot have a pre-image. Delete cannot have a post-image. Post-images require Post-operation. CRM validates other message-specific rules." Style="{StaticResource Caption}" Margin="4,16,4,0"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="28,16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                    <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" Margin="0,0,10,0"/>
                    <Button x:Name="SaveButton" Content="Save to development CRM" Click="Save_Click" Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
                <TextBlock x:Name="StatusText" Text="Preparing registration..." Style="{StaticResource Caption}" FontSize="12" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
